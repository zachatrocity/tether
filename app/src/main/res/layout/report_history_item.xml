<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/report_event_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="96dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/report_event_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="7dp"
        android:contentDescription="@null"
        android:src="@drawable/circle_filled"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorPrimary" />

    <View
        android:id="@+id/report_event_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/report_event_dot"
        app:layout_constraintStart_toStartOf="@id/report_event_dot"
        app:layout_constraintTop_toBottomOf="@id/report_event_dot" />

    <TextView
        android:id="@+id/report_event_age"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/report_event_dot"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="18 min ago" />

    <TextView
        android:id="@+id/report_event_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/report_event_age"
        app:layout_constraintTop_toBottomOf="@id/report_event_age"
        tools:text="New Apple network report" />

    <TextView
        android:id="@+id/report_event_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/report_event_age"
        app:layout_constraintTop_toBottomOf="@id/report_event_title"
        tools:text="Backpack AirTag reported near Pine Park entrance, accuracy ~80 m. Apple network report; not a live position." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/report_event_full_history"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="48dp"
        android:accessibilityTraversalAfter="@id/report_event_row"
        android:text="@string/detail_open_full_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/report_event_body" />
</androidx.constraintlayout.widget.ConstraintLayout>
